map <c-z> $ kill -STOP $PPID

map D delete

map <enter> open
# https://github.com/gokcehan/lf/discussions/2247
cmd paste-and-select %{{
    while read file; do
        if [ -z "$mode" ]; then
            mode="$file"
            continue
        fi
        if [ -f "${file}" ]; then
            # get 'basename' of the selection
            filename="$(basename ${file})"
            # quote it so we won't deal with quotes in the lf -remote command
            filename="$(printf '%q' "$filename")"
            break
        fi
    done < ~/.local/share/lf/files
    lf -remote "send $id paste"
    sleep 0.5
    lf -remote "send $id select ${filename}"
}}
map p paste-and-select

cmd copy-path &{{
    wl-copy "$fx"
}}
map Y copy-path

cmd copy-name &{{
    printf "%s" "$fx" | sed 's,.*/,,' | wl-copy
}}
map <c-y> copy-name

cmd z %{{
    res="$(zoxide query --exclude $PWD $@ | sed 's/\\/\\\\/g;s/"/\\"/g')"
    lf -remote "send $id cd \"$res\""
}}

cmd zi ${{
    res="$(zoxide query -i)"
    lf -remote "send $id cd \"$res\""
}}
map Z zi

set previewer ~/.config/lf/previewer.sh
set sixel

set history false
set mouse
set icons
