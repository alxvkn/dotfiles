# i3blocks configuration file
#
# The i3blocks man page describes the usage of the binary,
# and its website describes the configuration:
#
#     https://vivien.github.io/i3blocks


# Global properties
separator=true
separator_block_width=15
markup=pango

[sway/window]
command=$SCRIPT_DIR/sway/window
interval=persist

[playerctl]
command=$SCRIPT_DIR/playerctl
interval=persist

[quicknote]
LABEL=
command=$SCRIPT_DIR/quicknote
interval=persist

# [adb#phone]
# DEVICE_PATTERN=RMX3890
# LABEL=󰄜
# command=$SCRIPT_DIR/adb
# interval=persist

[ram]
LABEL=󰘚
command=$SCRIPT_DIR/c/ram
interval=5

[storage]
LABEL=󰋊
LABEL_TEMP=󱃃
command=$SCRIPT_DIR/c/storage
interval=5

[gnome_dark_mode]
command=$SCRIPT_DIR/gnome_dark_mode
min_width=
interval=persist

[network]
command=$SCRIPT_DIR/network
interval=persist

[ip]
command=ip -4 -brief addr show to 192.168.0.0/16 | awk '{print $3" via "$1}'
interval=60

[sensors#cpu]
command=$SCRIPT_DIR/sensors
interval=persist

[battery]
command=$SCRIPT_DIR/battery
interval=persist

[pulseaudio]
command=$SCRIPT_DIR/pulseaudio
interval=persist
format=json

[sway/keyboard_layout]
command=$SCRIPT_DIR/sway/keyboard_layout
interval=persist

# [weather]
# command=$SCRIPT_DIR/weather
# # 30 mins
# interval=1800

[date]
command=[ "$button" ] && notify-send -t 20000 -c calendar -a Date "$(date '+%A %d.%m.%Y')" "$(cal)"; date +'󰃭 %a %x'
interval=1

[time]
command=echo $(clock_icon_from_hour $(date +%k)) $(date +'%H:%M')
interval=1

[sway/scratchpad]
min_width= 1
LABEL=󱂬
LABEL_OPEN=<b>󱂬</b>
command=$SCRIPT_DIR/sway/scratchpad
interval=persist

